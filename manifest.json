{
  "id": "com.nebulastrike.spacefighter",
  "name": "Nebula Strike",
  "short_name": "NebulaStrike",
  "description": "A fast-paced 3D sci-fi space shooter with stunning OpenGL graphics and addictive arcade gameplay",

  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],

  "orientation": "portrait",

  "background_color": "#0a0a1a",
  "theme_color": "#00d4ff",

  "lang": "en",
  "dir": "ltr",

  "categories": ["games", "action", "arcade"],
  "content_rating": "everyone",

  "scope_extensions": [
    {
      "origin": "https://*.nebulastrike.app"
    },
    {
      "origin": "https://nebulastrike.pages.dev"
    },
    {
      "origin": "https://nebulastrike.vercel.app"
    }
  ],

  "icons": [
    { "src": "icons/icon-72x72.png", "sizes": "72x72", "type": "image/png", "purpose": "maskable any" },
    { "src": "icons/icon-96x96.png", "sizes": "96x96", "type": "image/png", "purpose": "maskable any" },
    { "src": "icons/icon-128x128.png", "sizes": "128x128", "type": "image/png", "purpose": "maskable any" },
    { "src": "icons/icon-144x144.png", "sizes": "144x144", "type": "image/png", "purpose": "maskable any" },
    { "src": "icons/icon-152x152.png", "sizes": "152x152", "type": "image/png", "purpose": "maskable any" },
    { "src": "icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable any" },
    { "src": "icons/icon-384x384.png", "sizes": "384x384", "type": "image/png", "purpose": "maskable any" },
    { "src": "icons/icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable any" }
  ],

  "screenshots": [
    {
      "src": "screenshots/gameplay-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Gameplay wide"
    },
    {
      "src": "screenshots/gameplay-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Gameplay mobile"
    }
  ],

  "shortcuts": [
    {
      "name": "Continue Game",
      "short_name": "Continue",
      "url": "/?action=continue",
      "icons": [{ "src": "icons/shortcut-play.png", "sizes": "96x96" }]
    },
    {
      "name": "Daily Rewards",
      "short_name": "Rewards",
      "url": "/?action=rewards",
      "icons": [{ "src": "icons/shortcut-gift.png", "sizes": "96x96" }]
    },
    {
      "name": "Leaderboard",
      "short_name": "Rankings",
      "url": "/?action=leaderboard",
      "icons": [{ "src": "icons/shortcut-trophy.png", "sizes": "96x96" }]
    }
  ],

  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },

  "file_handlers": [
    {
      "action": "/open-replay",
      "accept": {
        "application/nebula-replay": [".neb"],
        "application/json": [".json"]
      },
      "icons": [{ "src": "icons/icon-file-replay.png", "sizes": "256x256" }]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link"
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+nebulastrike",
      "url": "/join?code=%s"
    }
  ],

  "related_applications": [
    {
      "platform": "play",
      "id": "com.nebulastrike.spacefighter",
      "url": "https://play.google.com/store/apps/details?id=com.nebulastrike.spacefighter"
    }
  ],

  "prefer_related_applications": false
}
