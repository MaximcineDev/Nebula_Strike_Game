{
  "name": "nebula-strike",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "obfuscate": "javascript-obfuscator dist --output dist --config obfuscator-config.json",
    "capacitor:copy:after": "npm run obfuscate",
    "sync": "npm run build && npx cap sync",
    "build:prod": "npm run build && npm run obfuscate && npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-firebase/firestore": "^8.2.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.1",
    "vite": "^8.0.3"
  }
}
