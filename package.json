{
  "name": "nebula-strike",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "obfuscate": "javascript-obfuscator www --output www --config obfuscator-config.json",
    "sync:android": "npm run build && npm run obfuscate && npx cap copy android && npx cap update android",
    "sync:ios": "npm run build && npm run obfuscate && npx cap copy ios && npx cap update ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-firebase/firestore": "^8.2.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "javascript-obfuscator": "^5.4.1",
    "vite": "^8.0.3"
  }
}
