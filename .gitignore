# ===============================
# Nebula Strike .gitignore
# Web / PWA / GitHub Pages
# ===============================

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*~
.directory

# ---------- Logs ----------
*.log

# ---------- VS Code ----------
.vscode/

# ---------- Node / build ----------
node_modules/
dist/
.cache/
.tmp/

# ---------- Service worker cache ----------
sw.js.map

# ---------- Backup ----------
*.bak
*.tmp
*.temp
*.orig

# ---------- Keystore (if you build Android later) ----------
*.jks
*.keystore
*.p12
*.key
signing.properties
keystore.properties

# ---------- Ignore screenshots source files ----------
screenshots/*.psd
screenshots/*.xcf

# ===============================
# KEEP GAME FILES
# ===============================

!assets/
!icons/
!screenshots/
!index.html
!app.js
!styles.css
!manifest.json
!service-worker.js
